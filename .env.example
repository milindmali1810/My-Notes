# --- Telegram ---
# From @BotFather after creating your bot
TELEGRAM_BOT_TOKEN=

# Numeric chat ID of the "My notes" channel the bot must read from.
# The bot must be an ADMIN of this channel to receive channel_post updates.
TELEGRAM_SOURCE_CHANNEL_ID=

# Numeric chat ID to DM drafts/rejections to for review (usually your own
# private chat with the bot). See README.md for how to find this.
TELEGRAM_REVIEW_CHAT_ID=

# --- Gemini ---
GEMINI_API_KEY=

# Model used for the cheap pass/fail filter (stage 4)
FILTER_MODEL=gemini-flash-latest

# Model used for context-gathering (live search via Google Search grounding)
# and drafting (stages 3 & 5)
DRAFTING_MODEL=gemini-pro-latest

# --- Supabase (stage 6b: memory) ---
SUPABASE_URL=
SUPABASE_KEY=

# --- Paths ---
# Absolute path to the voice/style reference file (local runs only)
SKILL_PATH=D:\Mesa\AI WORKFLOWS\skill.txt

# --- Deployed webhook only (not used by local main.py) ---
# Random string that verifies incoming requests really come from Telegram.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=
